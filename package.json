{
  "name": "workspace-root",
  "version": "0.0.0",
  "private": true,
  "scripts": {
    "build": "turbo build",
    "dev": "turbo dev",
    "lint": "turbo lint",
    "format": "prettier --write README.md package.json \"packages/emblor/package.json\" \"packages/emblor/**/*.{ts,tsx,md}\" \"scripts/**/*.mjs\" \".github/workflows/*.yml\"",
    "prettier-check": "prettier --check README.md package.json \"packages/emblor/package.json\" \"packages/emblor/**/*.{ts,tsx,md}\" \"scripts/**/*.mjs\" \".github/workflows/*.yml\"",
    "test:browser": "pnpm -C packages/emblor test:browser",
    "distribution:format": "pnpm prettier-check",
    "distribution:build": "pnpm run build --filter \"./packages/*\"",
    "distribution:lint": "pnpm -C packages/emblor lint",
    "distribution:typecheck": "pnpm -C packages/emblor typecheck",
    "distribution:test": "pnpm -C packages/emblor test",
    "distribution:artifact": "pnpm -C packages/emblor test:distribution",
    "distribution": "node ./scripts/run-distribution-gate.mjs",
    "ci": "pnpm run distribution -- --skip-install",
    "release": "changeset publish",
    "release:dry-run": "node ./scripts/validate-release.mjs",
    "local-release": "changeset version && changeset publish",
    "prepublishOnly": "npm run ci"
  },
  "devDependencies": {
    "@changesets/cli": "^2.27.1",
    "@types/node": "18",
    "@typescript-eslint/parser": "^8.67.0",
    "eslint": "^9.9.1",
    "prettier": "^3.2.5",
    "tsup": "^6.5.0",
    "turbo": "latest",
    "typescript": "5.4.5",
    "zod": "^3.22.4"
  },
  "packageManager": "pnpm@9.0.2",
  "engines": {
    "node": ">=22 <23 || >=24 <25"
  }
}
