{
  "name": "website",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "next dev --turbopack --port 4500",
    "build": "next build",
    "start": "next start",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "lint:fix": "eslint . --fix",
    "format:write": "prettier --write \"**/*.{ts,tsx,md,mdx,json,css}\" --cache",
    "format:check": "prettier --check \"**/*.{ts,tsx,md,mdx,json,css}\" --cache",
    "generate:registry": "node scripts/generate-registry.ts",
    "validate:content": "node scripts/validate-content.ts",
    "validate:docs-code": "node scripts/validate-docs-code.mjs",
    "validate:api-docs": "node scripts/validate-api-docs.mjs",
    "validate:behavior-docs": "node scripts/validate-behavior-docs.mjs",
    "validate:registry": "node scripts/validate-registry.ts",
    "verify:consumer": "node scripts/verify-external-package.mjs",
    "test:registry-consumer": "node scripts/test-registry-consumer.mjs",
    "test:browser": "playwright test",
    "validate": "pnpm run format:check && pnpm run lint && pnpm run typecheck && pnpm run validate:content && pnpm run validate:docs-code && pnpm run validate:api-docs && pnpm run validate:behavior-docs && pnpm run validate:registry && pnpm run verify:consumer",
    "postbuild": "pagefind --site .next/server/app --output-path public/_pagefind"
  },
  "dependencies": {
    "@fumadocs/story": "1.2.0",
    "@hookform/resolvers": "5.9.1",
    "@radix-ui/react-dialog": "1.1.15",
    "@radix-ui/react-popover": "1.1.23",
    "@types/mdx": "2.0.14",
    "class-variance-authority": "0.7.1",
    "clsx": "2.1.1",
    "cmdk": "1.1.1",
    "emblor": "2.0.0-alpha.1",
    "fumadocs-core": "16.14.5",
    "fumadocs-mdx": "15.3.0",
    "fumadocs-ui": "16.14.5",
    "geist": "1.7.2",
    "lucide-react": "1.32.0",
    "next": "16.3.1",
    "postcss": "8.5.26",
    "radix-ui": "^1.6.7",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "react-easy-sort": "1.8.0",
    "react-hook-form": "7.87.0",
    "tailwind-merge": "3.6.0",
    "zod": "4.4.3"
  },
  "packageManager": "pnpm@9.15.0",
  "engines": {
    "node": ">=22 <23 || >=24 <25"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.13.0",
    "@playwright/test": "1.62.1",
    "@tailwindcss/postcss": "4.3.3",
    "@types/node": "26.2.0",
    "@types/react": "19.2.18",
    "@types/react-dom": "19.2.4",
    "baseline-browser-mapping": "2.11.15",
    "eslint": "9.39.1",
    "eslint-config-next": "16.3.1",
    "pagefind": "1.5.2",
    "prettier": "3.7.4",
    "shadcn": "4.18.0",
    "tailwindcss": "4.3.3",
    "tsx": "4.23.12",
    "typescript": "5.9.3"
  }
}
