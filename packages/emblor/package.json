{
  "name": "emblor",
  "version": "1.4.8",
  "private": false,
  "type": "module",
  "sideEffects": false,
  "license": "MIT",
  "main": "dist/index.cjs",
  "module": "dist/index.js",
  "types": "dist/index.d.ts",
  "exports": {
    "./package.json": "./package.json",
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.cjs",
      "default": "./dist/index.js"
    }
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "build": "tsup",
    "dev": "tsup --watch",
    "test": "vitest run",
    "test:compat": "node ./tests/compat/verify-packed-consumers.mjs",
    "test:distribution": "node ./tests/packaging/verify-distribution.mjs",
    "test:browser": "pnpm run build && playwright test --config playwright.config.ts",
    "lint": "eslint .",
    "typecheck": "tsc -p tsconfig.json --noEmit"
  },
  "peerDependencies": {
    "react": ">=18.0.0 <20.0.0",
    "react-dom": ">=18.0.0 <20.0.0"
  },
  "devDependencies": {
    "@testing-library/jest-dom": "^6.5.0",
    "@testing-library/react": "^15.0.0",
    "@testing-library/user-event": "^14.5.1",
    "@playwright/test": "^1.55.0",
    "@vitejs/plugin-react": "^4.3.0",
    "@types/react": "^18.2.40",
    "@types/react-dom": "^18.2.17",
    "eslint": "^9.0.0",
    "jsdom": "^24.0.0",
    "tsup": "^8.0.0",
    "typescript": "^5.6.0",
    "vite": "^5.4.0",
    "vitest": "^2.0.0"
  }
}
